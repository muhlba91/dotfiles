[user]
	name = Daniel Muehlbachler-Pietrzykowski
	email = daniel@muehlbachler.io
[core]
	excludesfile = ~/.gitignore_global
	autocrlf = input
[push]
	default = simple
[commit]
	gpgsign = true
[pull]
	rebase = true
[fetch]
	prune = true
[diff]
	colorMoved = zebra
[init]
	defaultBranch = main
[status]
	submoduleSummary = true
[tag]
	gpgSign = true
[include]
	# the machine's signing key (macOS: the YubiKey's GPG key; Linux: the host's git config, so no file here)
	path = ~/.config/git/gpg-signing
