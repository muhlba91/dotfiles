# Added by Toolbox App
export PATH="$PATH:$HOME/Library/Application Support/JetBrains/Toolbox/scripts"

# Homebrew environment (PATH, MANPATH, FPATH for completions)
eval "$(/opt/homebrew/bin/brew shellenv)"

# rustup is keg-only in Homebrew: cargo, rustc, etc. are proxies in its bin directory
export PATH="/opt/homebrew/opt/rustup/bin:$PATH"

# mise shims for GUI-launched apps (VS Code)
[[ -x /opt/homebrew/bin/mise ]] && eval "$(/opt/homebrew/bin/mise activate zsh --shims)"
